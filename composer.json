{
    "name": "coolycow/laravel-sms",
    "description": "Laravel-пакет для отправки SMS через подключаемые провайдеры",
    "keywords": ["laravel", "sms", "notification", "messaging"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maxim Kulikov",
            "email": "coolycow.com@gmail.com",
            "homepage": "https://coolycow.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/notifications": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Coolycow\\LaravelSms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coolycow\\LaravelSms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coolycow\\LaravelSms\\SmsServiceProvider"
            ],
            "aliases": {
                "Sms": "Coolycow\\LaravelSms\\Facades\\Sms"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "pint --test",
        "lint:fix": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
